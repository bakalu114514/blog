-shiki-dark:#666666\">&#x3C;/</span><span style=\"--shiki-light:#1E754F;--shiki-dark:#4D9375\">p</span><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">></span></span>\n<span class=\"line\"><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">&#x3C;/</span><span style=\"--shiki-light:#1E754F;--shiki-dark:#4D9375\">template</span><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">&#x3C;</span><span style=\"--shiki-light:#1E754F;--shiki-dark:#4D9375\">script</span><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">></span></span>\n<span class=\"line\"><span style=\"--shiki-light:#1E754F;--shiki-dark:#4D9375\">export</span><span style=\"--shiki-light:#1E754F;--shiki-dark:#4D9375\"> default</span><span style=\"--shiki-light:#999999;--shiki-dark:#666666\"> {</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#59873A;--shiki-dark:#80A665\">  data</span><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">()</span><span style=\"--shiki-light:#999999;--shiki-dark:#666666\"> {</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#1E754F;--shiki-dark:#4D9375\">    return</span><span style=\"--shiki-light:#999999;--shiki-dark:#666666\"> {</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#998418;--shiki-dark:#B8A965\">      isActive</span><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">:</span><span style=\"--shiki-light:#1E754F;--shiki-dark:#4D9375\"> true</span><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">,</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#998418;--shiki-dark:#B8A965\">      hasError</span><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">:</span><span style=\"--shiki-light:#1E754F;--shiki-dark:#4D9375\"> true</span><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">,</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#998418;--shiki-dark:#B8A965\">      classObject</span><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">:</span><span style=\"--shiki-light:#999999;--shiki-dark:#666666\"> {</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#998418;--shiki-dark:#B8A965\">        active</span><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">:</span><span style=\"--shiki-light:#1E754F;--shiki-dark:#4D9375\"> true</span><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">,</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#B5695977;--shiki-dark:#C98A7D77\">        '</span><span style=\"--shiki-light:#B56959;--shiki-dark:#C98A7D\">text-danger</span><span style=\"--shiki-light:#B5695977;--shiki-dark:#C98A7D77\">'</span><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">:</span><span style=\"--shiki-light:#1E754F;--shiki-dark:#4D9375\"> true</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">      },</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#998418;--shiki-dark:#B8A965\">      arrActive</span><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">:</span><span style=\"--shiki-light:#B5695977;--shiki-dark:#C98A7D77\"> '</span><span style=\"--shiki-light:#B56959;--shiki-dark:#C98A7D\">active</span><span style=\"--shiki-light:#B5695977;--shiki-dark:#C98A7D77\">'</span><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">,</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#998418;--shiki-dark:#B8A965\">      arrHasError</span><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">:</span><span style=\"--shiki-light:#B5695977;--shiki-dark:#C98A7D77\"> '</span><span style=\"--shiki-light:#B56959;--shiki-dark:#C98A7D\">text-danger</span><span style=\"--shiki-light:#B5695977;--shiki-dark:#C98A7D77\">'</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">    }</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">  }</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">}</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">&#x3C;/</span><span style=\"--shiki-light:#1E754F;--shiki-dark:#4D9375\">script</span><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">&#x3C;</span><span style=\"--shiki-light:#1E754F;--shiki-dark:#4D9375\">style</span><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">></span></span>\n<span class=\"line\"><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">.</span><span style=\"--shiki-light:#B07D48;--shiki-dark:#BD976A\">active</span><span style=\"--shiki-light:#999999;--shiki-dark:#666666\"> {</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#998418;--shiki-dark:#B8A965\">  font-size</span><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">:</span><span style=\"--shiki-light:#2F798A;--shiki-dark:#4C9A91\"> 30</span><span style=\"--shiki-light:#AB5959;--shiki-dark:#CB7676\">px</span><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">;</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">.</span><span style=\"--shiki-light:#B07D48;--shiki-dark:#BD976A\">text-danger</span><span style=\"--shiki-light:#999999;--shiki-dark:#666666\"> {</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#998418;--shiki-dark:#B8A965\">  color</span><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">:</span><span style=\"--shiki-light:#A65E2B;--shiki-dark:#C99076\"> red</span><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">;</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">}</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">&#x3C;/</span><span style=\"--shiki-light:#1E754F;--shiki-dark:#4D9375\">style</span><span style=\"--shiki-light:#999999;--shiki-dark:#666666\">></span></span></code></pre>\n<div class=\"line-numbers\" aria-hidden=\"true\" style=\"counter-reset:line-number 0\"><div class=\"line-number\"></div><div class=\"line-number\"></div><div class=\"line-number\"></div><div class=\"line-number\"></div><div class=\"line-number\"></div><div class=\"line-number\"></div><div class=\"line-number\"></div><div class=\"line-number\"></div><div class=\"line-number\"></div><div class=\"line-number\"></div><div class=\"line-number\"></div><div class=\"line-number\"></div><div class=\"line-number\"></div><div class=\"line-number\"></div><div class=\"line-number\"></div><div class=\"line-number\"></div><div class=\"line-number\"></div><div class=\"line-number\"></div><div class=\"line-number\"></div><div class=\"line-number\"></div><div class=\"line-number\"></div><div class=\"line-number\"></div><div class=\"line-number\"></div><div class=\"line-number\"></div><div class=\"line-number\"></div><div class=\"line-number\"></div><div class=\"line-number\"></div><div class=\"line-number\"></div><div class=\"line-number\"></div><div class=\"line-number\"></div><div class=\"line-number\"></div><div class=\"line-number\"></div><div class=\"line-number\"></div></div></div><hr>\n<h2 id=\"六、class-绑定方式对比总结\" tabindex=\"-1\"><a class=\"header-anchor\" href=\"#六、class-绑定方式对比总结\"><span>六、Class 绑定方式对比总结</span></a></h2>\n<table>\n<thead>\n<tr>\n<th>写法</th>\n<th>适用场景</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>对象语法</td>\n<td>样式与布尔状态直接对应</td>\n</tr>\n<tr>\n<td>数组语法</td>\n<td>多个类名组合、动态拼接</td>\n</tr>\n<tr>\n<td>数组 + 三元</td>\n<td>单个样式的条件控制</td>\n</tr>\n<tr>\n<td>数组嵌套对象</td>\n<td>复杂样式规则组合</td>\n</tr>\n</tbody>\n</table>\n<hr>\n<h2 id=\"小结\" tabindex=\"-1\"><a class=\"header-anchor\" href=\"#小结\"><span>小结</span></a></h2>\n<p>本次学习的重点包括：</p>\n<ul>\n<li><code v-pre>:class</code> 的对象语法与数组语法</li>\n<li>根据布尔状态动态控制样式</li>\n<li>数组与对象组合使用的规则</li>\n</ul>\n<p>Class 样式绑定是 Vue 中非常高频的功能，掌握它可以让页面样式与数据状态保持高度一致，为后续组件化开发打下基础。</p>\n","tagOpen":"<template>","tagClose":"</template>"},"script":null,"scriptSetup":null,"scripts":[],"styles":[],"customBlocks":[]},"content":"# Vue 学习笔记（六）：Class 样式绑定\r\n\r\n**日期：2025.12.24**  \r\n今天学习了 Vue 中的 **Class 样式绑定**。通过 `:class` 指令，可以根据数据状态动态地为元素添加或移除 CSS 类，是构建交互式界面时非常常用的一种方式。\r\n\r\n---\r\n\r\n## 一、为什么需要 Class 样式绑定？\r\n\r\n在原生 HTML 中，`class` 通常是写死的：\r\n\r\n```html\r\n<p class=\"active\">文本</p>\r\n```\r\n\r\n但在实际开发中，样式往往与**状态**有关，例如：\r\n\r\n- 是否被选中\r\n- 是否校验出错\r\n- 是否处于激活状态\r\n\r\nVue 提供的 `:class`（即 `v-bind:class`）可以让样式**与数据状态直接绑定**，从而实现响应式更新。\r\n\r\n---\r\n\r\n## 二、对象语法进行 Class 绑定\r\n\r\n### 1. 直接在模板中使用对象\r\n\r\n```vue\r\n<template>\r\n  <p :class=\"{ 'active': isActive, 'text-danger': hasError }\">\r\n    Class 样式绑定\r\n  </p>\r\n</template>\r\n```\r\n\r\n含义说明：\r\n\r\n- 对象的 **key** 是类名\r\n- 对象的 **value** 是布尔值\r\n- 当 value 为 `true` 时，对应的类名会被添加到元素上\r\n\r\n---\r\n\r\n### 2. 使用 data 中定义的对象（推荐）\r\n\r\n```vue\r\n<template>\r\n  <p :class=\"classObject\">Class 样式绑定 2</p>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      classObject: {\r\n        active: true,\r\n        'text-danger': true\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n```\r\n\r\n这种方式：\r\n\r\n- 模板更加简洁\r\n- 适合多个样式同时控制\r\n- 更利于维护和扩展\r\n\r\n---\r\n\r\n## 三、数组语法进行 Class 绑定\r\n\r\n当需要**同时绑定多个类名**，或者类名来源不止一个时，可以使用数组语法。\r\n\r\n### 1. 基本数组写法\r\n\r\n```vue\r\n<template>\r\n  <p :class=\"[arrActive, arrHasError]\">Class 样式绑定 3</p>\r\n</template>\r\n```\r\n\r\n```js\r\narrActive: 'active',\r\narrHasError: 'text-danger'\r\n```\r\n\r\n数组中的每一项都会被当作一个 class 名称进行绑定。\r\n\r\n---\r\n\r\n### 2. 数组中使用三元表达式\r\n\r\n```vue\r\n<template>\r\n  <p :class=\"[isActive ? 'active' : '']\">Class 样式绑定 4</p>\r\n</template>\r\n```\r\n\r\n说明：\r\n\r\n- 可以在数组中使用条件表达式\r\n- 常用于**单个样式根据条件切换**的场景\r\n\r\n---\r\n\r\n## 四、对象与数组的组合使用（补充）\r\n\r\n在实际开发中，对象和数组语法是可以组合使用的，但有一定规则。\r\n\r\n```vue\r\n<p :class=\"[{ active: isActive }, arrHasError]\"></p>\r\n```\r\n\r\n规则说明：\r\n\r\n- ✅ **数组中可以嵌套对象**\r\n- ❌ **对象中不能直接嵌套数组**\r\n\r\n这种写法在样式规则较复杂时非常有用。\r\n\r\n---\r\n\r\n## 五、完整示例代码（整理后）\r\n\r\n```vue\r\n<template>\r\n  <p :class=\"{ active: isActive, 'text-danger': hasError }\">Class 样式绑定</p>\r\n  <p :class=\"classObject\">Class 样式绑定 2</p>\r\n  <p :class=\"[arrActive, arrHasError]\">Class 样式绑定 3</p>\r\n  <p :class=\"[isActive ? 'active' : '']\">Class 样式绑定 4</p>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      isActive: true,\r\n      hasError: true,\r\n      classObject: {\r\n        active: true,\r\n        'text-danger': true\r\n      },\r\n      arrActive: 'active',\r\n      arrHasError: 'text-danger'\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style>\r\n.active {\r\n  font-size: 30px;\r\n}\r\n\r\n.text-danger {\r\n  color: red;\r\n}\r\n</style>\r\n```\r\n\r\n---\r\n\r\n## 六、Class 绑定方式对比总结\r\n\r\n| 写法 | 适用场景 |\r\n|----|----|\r\n| 对象语法 | 样式与布尔状态直接对应 |\r\n| 数组语法 | 多个类名组合、动态拼接 |\r\n| 数组 + 三元 | 单个样式的条件控制 |\r\n| 数组嵌套对象 | 复杂样式规则组合 |\r\n\r\n---\r\n\r\n## 小结\r\n\r\n本次学习的重点包括：\r\n\r\n- `:class` 的对象语法与数组语法\r\n- 根据布尔状态动态控制样式\r\n- 数组与对象组合使用的规则\r\n\r\nClass 样式绑定是 Vue 中非常高频的功能，掌握它可以让页面样式与数据状态保持高度一致，为后续组件化开发打下基础。","excerpt":"","includedFiles":[],"tasklistId":0,"title":"Vue 学习笔记（六）：Class 样式绑定","headers":[{"level":2,"title":"一、为什么需要 Class 样式绑定？","slug":"一、为什么需要-class-样式绑定","link":"#一、为什么需要-class-样式绑定","children":[]},{"level":2,"title":"二、对象语法进行 Class 绑定","slug":"二、对象语法进行-class-绑定","link":"#二、对象语法进行-class-绑定","children":[{"level":3,"title":"1. 直接在模板中使用对象","slug":"_1-直接在模板中使用对象","link":"#_1-直接在模板中使用对象","children":[]},{"level":3,"title":"2. 使用 data 中定义的对象（推荐）","slug":"_2-使用-data-中定义的对象-推荐","link":"#_2-使用-data-中定义的对象-推荐","children":[]}]},{"level":2,"title":"三、数组语法进行 Class 绑定","slug":"三、数组语法进行-class-绑定","link":"#三、数组语法进行-class-绑定","children":[{"level":3,"title":"1. 基本数组写法","slug":"_1-基本数组写法","link":"#_1-基本数组写法","children":[]},{"level":3,"title":"2. 数组中使用三元表达式","slug":"_2-数组中使用三元表达式","link":"#_2-数组中使用三元表达式","children":[]}]},{"level":2,"title":"四、对象与数组的组合使用（补充）","slug":"四、对象与数组的组合使用-补充","link":"#四、对象与数组的组合使用-补充","children":[]},{"level":2,"title":"五、完整示例代码（整理后）","slug":"五、完整示例代码-整理后","link":"#五、完整示例代码-整理后","children":[]},{"level":2,"title":"六、Class 绑定方式对比总结","slug":"六、class-绑定方式对比总结","link":"#六、class-绑定方式对比总结","children":[]},{"level":2,"title":"小结","slug":"小结","link":"#小结","children":[]}]}}
